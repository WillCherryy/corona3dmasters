+bool Background_Species::get_collision_inelastic()
+{
+	return collision_inelastic;
+}
+
+// declares whether a collision with this species at this collision energy (eV) is inelastic. Probability of inelastic = 1 - sigma_elastic/sigma_total
+// (both interpolated at the collision energy). Uses the separate generator type_gen, so the main random stream is not used.
+bool Background_Species::is_collision_inelastic(int part_index, double energy, double total_sigma)
+{
+	if (!elastic_interp[part_index])
+	{
+		return false;   // no elastic table: every collision of this species is elastic (as before)
+	}
+	double p_el = elastic_interp[part_index]->linterp(energy) / total_sigma;
+	if (p_el > 1.0)
+	{
+		p_el = 1.0;
+	}
+	double u = (double)(type_gen() >> 11) * (1.0 / 9007199254740992.0);   // uniform in [0, 1)
+	bool inelastic = (u >= p_el);
+	if (inelastic)
+	{
+		type_counts_inel[part_index]++;
+	}
+	else
+	{
+		type_counts_el[part_index]++;
+	}
+	return inelastic;
+}
+
+void Background_Species::print_collision_type_stats()
+{
+	for (int i=0; i<num_species; i++)
+	{
+		if (!elastic_interp[i])
+		{
+			continue;
+		}
+		long n = type_counts_el[i] + type_counts_inel[i];
+		cout << "Collision types for " << bg_parts[i]->get_name() << ": " << n << " collisions, elastic " << type_counts_el[i] << ", inelastic " << type_counts_inel[i];
+		if (n > 0)
+		{
+			cout << ", fraction inelastic " << (double)type_counts_inel[i] / (double)n;
+		}
+		cout << endl;
+	}
+}
